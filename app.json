{
  "expo": {
    "name": "智宠科技",
    "slug": "smartpet-senselab-app",
    "version": "0.1.1",
    "icon": "./assets/zhichong-app-icon.png",
    "orientation": "portrait",
    "scheme": "smartpet",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2",
      "bundleIdentifier": "com.smartpet.senselab",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "需要使用蓝牙连接设备、同步记录并发送控制指令。",
        "NSBluetoothPeripheralUsageDescription": "需要使用蓝牙连接设备、同步记录并发送控制指令。",
        "UIBackgroundModes": [
          "bluetooth-central"
        ]
      }
    },
    "android": {
      "package": "com.smartpet.senselab",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/zhichong-icon-foreground.png",
        "backgroundColor": "#101B4D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "需要使用相机扫描设备二维码以完成设备绑定。"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "需要使用蓝牙连接设备、同步记录并发送控制指令。"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101B4D",
          "image": "./assets/smartpet-wordmark.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de45fc37-10ac-4431-8f2b-47997f4290e8"
      }
    }
  }
}
